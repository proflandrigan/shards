{
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume|compact|clear", "hooks": [ { "type": "command", "command": "node \"{{SHARDS_HOOKS_DIR}}/session-start.js\"" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "node \"{{SHARDS_HOOKS_DIR}}/user-prompt-submit.js\"" } ] }
    ],
    "PreToolUse": [
      { "matcher": ".*", "hooks": [ { "type": "command", "command": "node \"{{SHARDS_HOOKS_DIR}}/pre-tool-use.js\"" } ] }
    ]
  }
}
