{
  "id": "01-syn-to-data-analyst-quick",
  "title": "Syn triage to Data Analyst quick analysis",
  "description": "User asks a small adhoc question via /shards; Syn triages, creates the project dir and specs, hands off to the Data Analyst, who runs the 4-phase quick track.",
  "agent_entry": "/shards",
  "output_dir_glob": "analysis/*",
  "forced_compactions": 0,
  "user_turns": [
    {
      "text": "What is the weekly active teacher count by region for last quarter? Quick question, warehouse is Snowflake.",
      "kind": "request"
    },
    {
      "text": "Great, go ahead.",
      "kind": "confirm"
    },
    {
      "text": "Ready, continue (compact done).",
      "kind": "confirm"
    },
    {
      "text": "Yes, that framing is right. Active means at least one login.",
      "kind": "confirm"
    },
    {
      "text": "Yes but change the output to a CSV plus a short summary, no chart.",
      "kind": "revise"
    },
    {
      "text": "Looks good, run it.",
      "kind": "confirm"
    },
    {
      "text": "Results make sense, approved.",
      "kind": "confirm"
    },
    {
      "text": "Approved, wrap it up.",
      "kind": "confirm"
    }
  ],
  "expected_routing": [
    "syn",
    "data-analyst"
  ],
  "expected_artifacts": [
    {
      "path": "project-specs.md",
      "required": true
    },
    {
      "path": "*.sql",
      "required": true
    },
    {
      "path": "**/*.csv",
      "required": false
    },
    {
      "path": "summary.md",
      "required": true
    }
  ],
  "expected_gates": [
    {
      "id": "data-analyst-phase-1",
      "kind": "phase",
      "min": 1
    },
    {
      "id": "data-analyst-phase-2",
      "kind": "phase",
      "min": 1,
      "allowed_reemits": 1
    },
    {
      "id": "data-analyst-phase-3",
      "kind": "phase",
      "min": 1
    },
    {
      "id": "data-analyst-phase-4",
      "kind": "final",
      "min": 1
    }
  ],
  "forbidden": [
    {
      "id": "agent-approves-own-gate",
      "type": "gate_self_approval",
      "description": "Agent emits a phase/final/execute gate and proceeds to the next gate without a human turn in between"
    },
    {
      "id": "reask-confirmed-gate",
      "type": "gate_reask",
      "description": "Agent re-emits a gate the user already confirmed (e.g. after compaction); only gates listed in allowed_reemits may repeat",
      "allowed_reemits": {
        "data-analyst-phase-2": 1
      }
    },
    {
      "id": "wrong-specialist",
      "type": "forbidden_agents",
      "agents": [
        "data-scientist",
        "data-engineer",
        "ml-engineer"
      ],
      "description": "Quick adhoc question must not escalate to a deep/other specialist"
    }
  ],
  "weights": {
    "artifacts": 30,
    "gates": 30,
    "routing": 20,
    "forbidden": 20
  },
  "next_build_targets": {
    "max_human_approvals_total": 6
  }
}
