{
  "name": "shards-ide",
  "version": "0.1.0",
  "description": "Shards IDE — Desktop application for the Shards agent suite",
  "author": {
    "name": "JFL",
    "email": "proflandrigan@gmail.com"
  },
  "license": "MIT",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/proflandrigan/shards.git"
  },
  "scripts": {
    "start": "electron .",
    "vendor": "bash download-vendor.sh",
    "prebuild": "bash download-vendor.sh",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder -mwl",
    "postinstall": "electron-builder install-app-deps"
  },
  "overrides": {
    "node-pty": {
      "node-gyp": "^10.0.0"
    }
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "node-pty": "^1.0.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "electron-updater": "^6.3.0"
  },
  "build": {
    "appId": "com.shards.ide",
    "productName": "Shards IDE",
    "artifactName": "Shards-IDE-${version}-${arch}.${ext}",
    "files": [
      "**/*",
      "!icons/",
      "!download-vendor.sh"
    ],
    "extraResources": [
      {
        "from": "../src",
        "to": "src",
        "filter": ["**/*"]
      },
      {
        "from": "../tools",
        "to": "tools",
        "filter": ["**/*"]
      },
      {
        "from": "../templates",
        "to": "templates",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "icons/icon.icns",
      "darkModeSupport": true
    },
    "dmg": {
      "title": "Shards IDE",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Shards IDE"
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "category": "Development",
      "icon": "icons",
      "desktop": {
        "Name": "Shards IDE",
        "Comment": "Desktop IDE for the Shards agent suite",
        "Terminal": "false"
      }
    },
    "publish": {
      "provider": "github",
      "owner": "proflandrigan",
      "repo": "shards"
    }
  }
}
