{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://shards.dev/schema/gate-request.schema.json",
  "title": "gate_request tool input (E11.2)",
  "type": "object",
  "required": [
    "id",
    "kind",
    "phase",
    "summary",
    "record_ref"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "maxLength": 128
    },
    "kind": {
      "type": "string",
      "enum": [
        "phase",
        "final",
        "checkpoint",
        "execute",
        "confirm",
        "handoff"
      ]
    },
    "phase": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^\\d+(-\\d+)?$"
        }
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "record_ref": {
      "type": "string",
      "minLength": 1
    },
    "validates": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "maxLength": 128
    },
    "plan_approval": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "maxLength": 128,
      "description": "Marks this gate as the plan approval for run <value> (gate policy `plan`). A confirmed gate re-requested with a different run starts over as a fresh gate."
    },
    "targets": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 512 },
      "maxItems": 100,
      "uniqueItems": true
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail",
            "anomaly"
          ]
        },
        "summary": {
          "type": "string",
          "maxLength": 2000
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          },
          "maxItems": 100
        }
      }
    }
  }
}
