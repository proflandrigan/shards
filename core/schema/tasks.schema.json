{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://shards.dev/schema/tasks.schema.json",
  "title": "Task manifest (<output_dir>/tasks.yaml)",
  "type": "object",
  "required": ["version", "tasks"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "tasks": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/task" } }
  },
  "definitions": {
    "task": {
      "type": "object",
      "required": ["id", "goal", "plan_ref", "inputs", "owned_paths", "acceptance", "worker", "size"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "goal": { "type": "string", "minLength": 1 },
        "plan_ref": { "type": "string", "minLength": 1 },
        "inputs": { "type": "array", "items": { "type": "string" } },
        "owned_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "acceptance": {
          "type": "object",
          "required": ["command", "expected"],
          "additionalProperties": false,
          "properties": {
            "command": { "type": "string", "minLength": 1 },
            "expected": { "type": "string", "minLength": 1 },
            "cwd": { "type": "string", "minLength": 1, "description": "Project-root-relative directory to run the command from (default: the project root). AR iteration cards: the branch worktree." }
          }
        },
        "depends_on": { "type": "array", "items": { "type": "string" }, "default": [] },
        "worker": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 1, "maximum": 60 },
        "phase": { "anyOf": [{ "type": "string" }, { "type": "integer" }] },
        "delegate": { "enum": ["inline", "worker"], "default": "worker" },
        "ar": {
          "type": "object",
          "description": "Marks an autonomous-research iteration card (issue #91, H4). task_verify then takes the AR outcome (ar_iteration or metric_outcome): GREEN or kept YELLOW is done (kept), RED or unkept YELLOW is done (reverted), never failed.",
          "required": ["run_id"],
          "additionalProperties": false,
          "properties": {
            "run_id": { "type": "string", "minLength": 1 },
            "branch": { "type": "string", "minLength": 1 },
            "iteration": { "type": "integer", "minimum": 1 },
            "hypothesis": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
